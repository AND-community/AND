# Auto detect text files and perform LF normalization
* text=auto

# Gömülen lisans metinleri her platformda LF ile çekilsin: terminale basılırlar
# ve CR karakteri tam ekran arayüzü bozar (bkz. internal/lisans).
internal/lisans/*.txt text eol=lf

# "and eklenti yeni"nin gömülü iskelet şablonları da LF: üretilen go.mod ve
# Go dosyaları her platformda aynı olsun (bkz. internal/eklentisablon).
internal/eklentisablon/sablon/* text eol=lf

# Simge, logo ve Windows kaynak nesneleri ikilidir; bayt bayt korunmalılar
# (cmd/and/winres/uret'in testi depodaki .syso'ları yeniden üretip karşılaştırır).
*.syso binary
*.ico binary
*.png binary

# Masaüstü arayüzüne gömülen xterm.js, npm paketinden olduğu gibi kopyalanır
# (sürümü ve lisansı: internal/lisans/uret, webBilesenleri).
internal/masaustu/web/xterm/** linguist-vendored -diff
internal/masaustu/web/xterm-fit/** linguist-vendored -diff
