{
  "name": "and-vscode",
  "displayName": "AND",
  "description": "%description%",
  "version": "0.9.0",
  "icon": "resources/icon.png",
  "publisher": "Lucian95511",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/AND-community/AND.git",
    "directory": "and-vscode"
  },
  "bugs": {
    "url": "https://github.com/AND-community/AND/issues"
  },
  "homepage": "https://github.com/AND-community/AND/tree/main/and-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "and",
    "deltax",
    "vcs",
    "p2p",
    "source control",
    "site"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onFileSystem:and-site-edit"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": [
      {
        "title": "AND",
        "properties": {
          "and.language": {
            "type": "string",
            "enum": [
              "auto",
              "tr",
              "en",
              "de",
              "es",
              "fr",
              "ru"
            ],
            "enumItemLabels": [
              "%config.and.language.auto%",
              "Türkçe",
              "English",
              "Deutsch",
              "Español",
              "Français",
              "Русский"
            ],
            "default": "auto",
            "markdownDescription": "%config.and.language%"
          }
        }
      },
      {
        "title": "DeltaX",
        "properties": {
          "deltax.dataDir": {
            "type": "string",
            "default": "",
            "markdownDescription": "%config.deltax.dataDir%"
          },
          "deltax.authorName": {
            "type": "string",
            "default": "",
            "description": "%config.deltax.authorName%"
          }
        }
      }
    ],
    "configurationDefaults": {
      "[and-site]": {
        "files.autoSave": "off",
        "editor.wordWrap": "on"
      }
    },
    "languages": [
      {
        "id": "and-site",
        "aliases": [
          "%language.and-site%",
          "and-site"
        ],
        "extensions": [
          ".andsite"
        ]
      }
    ],
    "grammars": [
      {
        "language": "and-site",
        "scopeName": "text.and-site",
        "path": "./syntaxes/and-site.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deltax",
          "title": "DeltaX",
          "icon": "resources/activitybar.svg"
        }
      ]
    },
    "views": {
      "deltax": [
        {
          "id": "deltaxGroups",
          "name": "%view.deltaxGroups%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deltaxGroups",
        "contents": "%viewsWelcome.deltaxGroups%"
      }
    ],
    "commands": [
      {
        "command": "deltax.refresh",
        "title": "%deltax.refresh%",
        "category": "DeltaX",
        "icon": "$(refresh)"
      },
      {
        "command": "deltax.openProject",
        "title": "%deltax.openProject%",
        "category": "DeltaX",
        "icon": "$(folder-opened)"
      },
      {
        "command": "deltax.newProject",
        "title": "%deltax.newProject%",
        "category": "DeltaX",
        "icon": "$(new-folder)"
      },
      {
        "command": "deltax.createGroup",
        "title": "%deltax.createGroup%",
        "category": "DeltaX",
        "icon": "$(add)"
      },
      {
        "command": "deltax.inviteMember",
        "title": "%deltax.inviteMember%",
        "category": "DeltaX",
        "icon": "$(person-add)"
      },
      {
        "command": "deltax.showInvites",
        "title": "%deltax.showInvites%",
        "category": "DeltaX",
        "icon": "$(mail)"
      },
      {
        "command": "deltax.manageAdmins",
        "title": "%deltax.manageAdmins%",
        "category": "DeltaX"
      },
      {
        "command": "deltax.leaveOrCloseGroup",
        "title": "%deltax.leaveOrCloseGroup%",
        "category": "DeltaX"
      },
      {
        "command": "deltax.pushProject",
        "title": "%deltax.pushProject%",
        "category": "DeltaX",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "deltax.pullFromMember",
        "title": "%deltax.pullFromMember%",
        "category": "DeltaX",
        "icon": "$(cloud-download)"
      },
      {
        "command": "deltax.commit",
        "title": "%deltax.commit%",
        "category": "DeltaX",
        "icon": "$(check)"
      },
      {
        "command": "deltax.showLog",
        "title": "%deltax.showLog%",
        "category": "DeltaX",
        "icon": "$(history)"
      },
      {
        "command": "deltax.switchBranch",
        "title": "%deltax.switchBranch%",
        "category": "DeltaX",
        "icon": "$(git-branch)"
      },
      {
        "command": "deltax.newBranch",
        "title": "%deltax.newBranch%",
        "category": "DeltaX"
      },
      {
        "command": "deltax.merge",
        "title": "%deltax.merge%",
        "category": "DeltaX",
        "icon": "$(git-merge)"
      },
      {
        "command": "deltax.exportZip",
        "title": "%deltax.exportZip%",
        "category": "DeltaX",
        "icon": "$(package)"
      },
      {
        "command": "deltax.openIgnoreFile",
        "title": "%deltax.openIgnoreFile%",
        "category": "DeltaX"
      },
      {
        "command": "deltax.openChange",
        "title": "%deltax.openChange%",
        "category": "DeltaX"
      },
      {
        "command": "and.openLivePanel",
        "title": "%and.openLivePanel%",
        "category": "AND",
        "icon": "$(radio-tower)"
      },
      {
        "command": "and.shareSelectionToForum",
        "title": "%and.shareSelectionToForum%",
        "category": "AND",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "and.sendFileToPeer",
        "title": "%and.sendFileToPeer%",
        "category": "AND",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "and.site.newPage",
        "title": "%and.site.newPage%",
        "category": "AND",
        "icon": "$(new-file)"
      },
      {
        "command": "and.site.openPage",
        "title": "%and.site.openPage%",
        "category": "AND",
        "icon": "$(globe)"
      },
      {
        "command": "and.site.deletePage",
        "title": "%and.site.deletePage%",
        "category": "AND",
        "icon": "$(trash)"
      },
      {
        "command": "and.site.copyShareCode",
        "title": "%and.site.copyShareCode%",
        "category": "AND",
        "icon": "$(link)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deltax.createGroup",
          "when": "view == deltaxGroups",
          "group": "navigation"
        },
        {
          "command": "deltax.refresh",
          "when": "view == deltaxGroups",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "deltax.openProject",
          "when": "view == deltaxGroups && viewItem == deltaxProject",
          "group": "inline"
        },
        {
          "command": "deltax.pushProject",
          "when": "view == deltaxGroups && viewItem == deltaxProject",
          "group": "1_actions"
        },
        {
          "command": "deltax.pullFromMember",
          "when": "view == deltaxGroups && viewItem == deltaxProject",
          "group": "1_actions"
        },
        {
          "command": "deltax.exportZip",
          "when": "view == deltaxGroups && viewItem == deltaxProject",
          "group": "1_actions"
        },
        {
          "command": "deltax.newProject",
          "when": "view == deltaxGroups && viewItem == deltaxGroup",
          "group": "inline"
        },
        {
          "command": "deltax.inviteMember",
          "when": "view == deltaxGroups && viewItem == deltaxGroup",
          "group": "1_actions"
        },
        {
          "command": "deltax.manageAdmins",
          "when": "view == deltaxGroups && viewItem == deltaxGroup",
          "group": "1_actions"
        },
        {
          "command": "deltax.leaveOrCloseGroup",
          "when": "view == deltaxGroups && viewItem == deltaxGroup",
          "group": "2_danger"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "deltax.openChange",
          "when": "scmProvider == deltax",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "and.shareSelectionToForum",
          "group": "9_and"
        }
      ],
      "explorer/context": [
        {
          "command": "and.sendFileToPeer",
          "when": "!explorerResourceIsFolder",
          "group": "9_and"
        }
      ],
      "commandPalette": [
        {
          "command": "deltax.openChange",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "and.site.copyShareCode",
          "when": "resourceScheme == and-site-edit",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out-test/*.test.js out-test/live/*.test.js out-test/live/deltax/*.test.js out-test/live/site/*.test.js out-test/dil/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "@vscode/vsce-sign@2.0.9": true,
    "keytar@7.9.0": true
  }
}
